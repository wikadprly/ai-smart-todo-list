# =============================================================================
# Salin file ini menjadi .env lalu isi dengan nilai aslimu.
# .env TIDAK boleh di-commit ke GitHub.
# =============================================================================

# --- Database (PostgreSQL) ----------------------------------------------------
# Prisma membaca ini lewat prisma.config.mjs
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_smart_todo?schema=public"

# --- Session / Auth -----------------------------------------------------------
# Ganti dengan string acak panjang, contoh: openssl rand -hex 32
SESSION_SECRET="ganti-dengan-string-acak-panjang"
SESSION_MAX_AGE_DAYS="7"

# --- AI Provider -------------------------------------------------------------
# Pilih salah satu: "gemini" atau "openai". Kosongkan dulu kalau belum dipakai.
AI_PROVIDER=""

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL=""

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=""
OPENAI_MODEL=""
